@model IEnumerable<Blog.Models.User>

@{
    ViewBag.Title = "Chi tiết user";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
    <link rel="stylesheet" href="~/fonts/fontawesome-free-6.1.2-web/css/all.css">

}
<a href="@Url.Action("Index", "User")">
    <div class="back">
        <div class="btn_back">
        </div>
        <span> Trở về trang quản lý user</span>
    </div>
</a>

<div class="ctuser_title">Chi tiết user</div>
<div class="user">
    @foreach (var item in Model)
    {
        <div class="ctuser row">
            <div class="ctuser_info col-lg-6">
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Mã ID</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.IDUser</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Họ và tên</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.UserName</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Số điện thoại</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.PhoneNumber</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Mật khẩu</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Password</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Email</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Email</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Giới tính</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Sex</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Ngày sinh</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@DateTime.Parse(@item.Birthday.ToString()).ToShortDateString()</div>
                </div>
            </div>
            <div class="ctuser_info col-lg-6">
                <div class="info-item row">
                    <div class="info_item-child  col-lg-4 col-md-4 col-sm-4 info_item-title">Địa chỉ</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Address</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Bằng cấp</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Degree</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Công việc</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Job</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Facebook</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Facebook</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Instagram</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Instagram</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">Youtube</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.Youtube</div>
                </div>
                <div class="info-item row">
                    <div class="info_item-child col-lg-4 col-md-4 col-sm-4 info_item-title">LinkedIn</div>
                    <div class="info_item-child col-lg-8 col-md-8 col-sm-8">@item.LinkedIn</div>
                </div>
            </div>

        </div>


    }
</div>
<style>
    .back {
        padding-top:16px;
        display:flex;
        align-items:center;
    }

    .btn_back {
        background-image: url(../../../../Images/back-button-svgrepo-com.svg);
        width: 30px;
        height: 30px;
        background-repeat: no-repeat;
        margin-right:8px;
    }


    .ctuser_title {
        color: #F05;
        font-size: 40px;
        text-align: center;
    }

    .info-item {
        
    }

    .info_item-child {
        border: 1px solid #ccc;
        height: 50px;
        display: flex;
        align-items: center;
        font-size: 18px;
        padding-top: 2px;
        padding-bottom:2px;

    }

    .info_item-title {
        color: #45C26B;
        font-weight: 500;
        font-style: italic;
    }

    .ctuser {
        padding: 5%;
    }
    .ctuser_info:first-child {
        border-right:2px solid #000;
    }
</style>