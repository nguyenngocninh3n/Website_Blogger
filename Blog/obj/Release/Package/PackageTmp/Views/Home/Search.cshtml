            line-height: 20px;
        }

    .behavior_like {
        display: flex;
    }

    .behaviour {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid #ccc;
        padding: 0 2px;
    }

    .behaviour_item {
        padding: 4px 24px 0px;
        border-radius: 8px;
    }

        .behaviour_item p {
            font-size: 14px;
        }

    .behaviour_like {
        flex: 7;
    }

    .behaviour_comment, .behaviour_share {
        flex: 1;
    }
</style>

