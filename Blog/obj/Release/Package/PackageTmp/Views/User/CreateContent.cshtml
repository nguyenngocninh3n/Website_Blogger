@model IEnumerable<Blog.Models.Menu>
@{
    Layout = null;
}


<div class="create">
    <div class="create_content-avatar"> </div>
    <input id="createcontent" onclick="showCreateContent()" class="create_input" placeholder="Đăng bài..." />
    <div id="showhide" class="newcontent">
        <p class="newcontent_title">
            Tạo bài viết
        </p>
        @using (Html.BeginForm("CreateContent", "User", FormMethod.Post))
        {
            @Html.ValidationSummary(true)
            <div class="newcontent_body">
                <div id="newcontent_cancel" onclick="hideCreateContent()"></div>
                @ViewData["ErrTitle"]
                <input type="text" placeholder="Tiêu đề..." id="title" name="title" class="newcontent_item newcontent_item-title" />
                @ViewData["ErrType"]
                <div class="typeselection">
                    <div class="type_title">
                        Thể loại:
                    </div>
                    <div class="type_list">
                        @foreach (var item in Model)
                        {
                            if (item.ParentId == 2)
                            {
                                <div class="type_list-item">
                                    <input class="type_list-btn" type="checkbox" name="@item.Id" />
                                    <div class="type_list-title" name="@item.Id">
                                        <span>  @item.MenuName</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
                @ViewData["ErrContent"]
                <textarea size="40" maxlength="4000" id="content" name="content" type="text" placeholder="Nội dung..." class="newcontent_item newcontent_item-content"></textarea>
                <input type="submit" class="newcontent_item newcontent_submit" value="Đăng" />
            </div>
        }
    </div>

</div>

<script>
    $(document).on('click', "div[class='type_list-item']", function () {
      
        if ($(this).children()[0].checked == false) {
            $($(this).children()[1]).addClass('checkedType');
            $(this).children()[0].checked = true;
        }
        else {
            $($(this).children()[1]).removeClass('checkedType');
            $(this).children()[0].checked = false;
        }
    })
</script>


