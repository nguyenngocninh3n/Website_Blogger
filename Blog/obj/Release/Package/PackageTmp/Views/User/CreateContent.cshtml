    }

    .newcontent_item {
        border-radius: 28px;
        font-size: 20px;
        max-width: 100%;
        border: none;
        padding: 4px 24px;
    }

    .newcontent_item-content {
        padding-top: 8px;
        margin: 24px 0;
        height: 200px;
    }

    .newcontent_submit {
        background: blue;
        padding: 4px 0;
        width: 100%;
    }

  
</style>


<script>

    const closeF = document.getElementById('newcontent_cancel')

        //hiện form
    function showCreateContent() {
        const openF = document.getElementById('showhide')
        openF.classList.add('open')
        }

        //ẩn form
    function hideCreateContent() {
        const openF = document.getElementById('showhide')
        openF.classList.remove('open')
    }

</script>