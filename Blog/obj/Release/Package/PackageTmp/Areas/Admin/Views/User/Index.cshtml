@model IEnumerable<Blog.Models.User>
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/LayoutAdmin.cshtml";
}

<h2 class="user_title">Quản lý user</h2>
<span style="text-align:center; color:orangered;">@ViewData["err"]</span>
<div><a href="@Url.Action("Create", "User")">Thêm mới</a></div>
<div class="nav_item ">
    @using (Html.BeginForm("Index", "User", FormMethod.Post))
    {
        @Html.ValidationSummary(true)
        <div class="search">
            <div class="search_item item_form">
                <input class="search_sub-item search_form" name="search" placeholder="Tìm kiếm...." />
            </div>
            <div class="search_item item_type">
                <select name="type" class="search_sub-item search_type">
                    <option class="type_selected" value="IDUser">Mã ID</option>
                    <option class="type_selected" value="UserName">Họ tên</option>
                    <option class="type_selected" value="PhoneNumber">Số điện thoại</option>
                    <option class="type_selected" value="Sex">Giới tính</option>
                    <option class="type_selected" value="Email">Email</option>
                    <option class="type_selected" value="Address">Địa chỉ</option>
                    <option class="type_selected" value="Job">Công việc</option>
                    <option class="type_selected" value="Degree">Bằng cấp</option>
                   

                </select>
            </div>
            <div class="search_item item_icon">
                <button type="submit" class="search_sub-item search_icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
            </div>
        </div>
    }
</div>
<div class="user">
    <div class="qluser bg-success">
        <div class="qluser_item">Mã ID</div>
        <div class="qluser_item">Họ và tên</div>
        <div class="qluser_item">Số điện thoại</div>
        <div class="qluser_item">Mật khẩu</div>
        <div class="qluser_item">Giới tính</div>
        <div class="qluser_item">Email</div>
        <div class="qluser_item qluser_btn">
            <div class="user_btn"></div>
            <div class="user_btn"></div>
            <div class="user_btn"></div>
        </div>
    </div>
    @foreach (var item in Model)
    {
        <div>
            <div class="qluser">
                <div class="qluser_item">@item.IDUser</div>
                <div class="qluser_item">@item.UserName</div>
                <div class="qluser_item">@item.PhoneNumber</div>
                <div class="qluser_item">@item.Password</div>
                <div class="qluser_item">@item.Sex</div>
                <div class="qluser_item">@item.Email</div>
                <div class="qluser_item qluser_btn">
                    <div class="user_btn"><a class="user_btn-detail btn-info" href="@Url.Action("Detail", "User", new { idUser = item.IDUser})">Chi tiết</a></div>
                    <div class="user_btn user_mini"><a class="user_btn-edit btn-primary" href="@Url.Action("Edit", "User", new { idUser = item.IDUser})">Sửa</a></div>
                    <div id="btn_delete" class="user_btn user_mini user_btn-delete btn-danger">Xóa</div>
                </div>
            </div>
            <div class="notify" id="notify">
                <div class="notify_box">
                    <div class="notify_cancel" id="btn_cancel"></div>
                    <div class="notify_title notify_text">Bạn có muốn xóa không</div>
                    <div class="notify_options">
                        <a href="@Url.Action("Delete", "User", new {idUser = item.IDUser })" class="notify_option notify_text option_submit" id="option_submit">Xóa</a>
                        <div class="notify_option notify_text option_cancel" id="option_cancel">Hủy</div>
                    </div>
                </div>
            </div>
        </div>
    }


</div>



<script>

    //đóng form xóa bài viết - lựa chọn nhấn nút X
    $(document).on('click', "div[id='btn_cancel']", function () {
        let btnshow = $($(this).parent().parent()).removeClass('open_deleteFrom');
    });

    //mở yêu cầu đăng nhập
    $(document).on('click', "div[id='btn_delete']", function () {
        //$(document.getElementById('notify')).removeClass('hide');
        $($(this).parent().parent().parent().children()[1]).addClass('open_deleteFrom');
    });


    //đóng yêu cầu đăng nhập bằng cancel
    $(document).on('click', "div[id='option_cancel']", function () {
        $($(this).parent().parent().parent()).removeClass('open_deleteFrom');
    });
</script>
<style>
    .search {
        position: relative;
        display: flex;
        flex-direction: row;
        padding: 8px 10px;
    }
    .search_sub-item {
        height: 28px;
    }

    .search_item {
        height: 28px;
        color: #000;
        padding: 2px;
        margin-left: -5px;
    }

    .search_type {
        width: 80px;
        background: #eee;
    }

    .search_form {
        font-size: 16px;
    }

    .item_icon {
        background: #fff;
        height: 28px;
        margin-top: 2px;
        border: 2px solid #ccc;
        margin-left: -3px;
        width: 30px;
    }

    .search_icon {
        background: #fff;
        height: 20px;
        border: none;
        margin: auto;
    }

        .search_icon i {
            display: block;
            margin: auto auto auto 3px;
        }


    .user_title {
        color: #F05;
        font-size: 40px;
        text-align: center;
    }

    .notify {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        display: none;
        align-items: center;
        justify-content: center;
        background-color: rgba(0,0,0,0.08);
    }

    .notify_box {
        width: 400px;
        height: 150px;
        margin: auto;
        background: #fff;
        position: relative;
        padding-top: 32px;
    }

    .notify_title .notify_text {
        font-size: 22px;
    }

    .notify_options {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50px;
        display: flex;
    }

    .user_btn-delete {
        display: flex;
        justify-content: center;
    }

    .notify_option {
        width: 50%;
        height: 100%;
        text-align: center;
        border: 1px solid #eee;
        display: flex;
        justify-content: center;
        align-content: center;
        height: 100%;
        padding: calc( ( 40px - 32px ) / 2) 0;
        cursor: pointer;
        opacity: 0.7;
    }

    .option_submit {
        background: #4cff00;
    }

        .option_submit:hover {
            opacity: 1;
        }

    .option_cancel {
        background: #ede;
    }

        .option_cancel:hover {
            opacity: 1;
        }

    .notify_text {
        font-size: 24px;
        text-align: center;
    }

    .open_deleteFrom {
        display: flex !important;
    }
</style>

<style>
    .user {
        width: 100%;
        max-height: 100%;
        height: 100%;
    }

    .qluser {
        display: flex;
        border-left: 1px solid #615b5b;
        max-height: 100%;
    }

    .qluser_item {
        width: 160px;
        display: flex;
        min-height: 30px;
        height: 100%;
        max-height: 100%;
        justify-content: center;
        border-right: 1px solid #615b5b;
        border-bottom: 1px solid #615b5b;
        align-items: center;
    }

        .qluser_item.qluser_btn {
            width: 200px;
        }

    .user_btn {
        display: block;
        width: 60px;
        min-height: 100%;
        margin: 0 3px;
        display: flex;
    }

        .user_btn a {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
        }

        .user_btn:hover {
            background: #ffd800;
        }
</style>
