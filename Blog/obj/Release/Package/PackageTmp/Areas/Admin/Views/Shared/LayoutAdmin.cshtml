
@{
    Layout = null;
    <link rel="stylesheet" href="~/fonts/fontawesome-free-6.1.2-web/css/all.css">

}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>LayoutAdmin</title>
</head>
<body>
    <div class="layoutadmin ">
        <div class="layout_header">
            @Html.Action("HeaderPartial", "Home")
        </div>
        <div class="layout_body">
            <div class="layout_nav ">
                @Html.Action("NavparPartial", "Home")
            </div>
            <div class="layout_content">
                @RenderBody()
            </div>
        </div>
        <div class="layout_footer">
            @Html.Action("FooterPartial", "Home")
        </div>
    </div>
</body>
</html>


@RenderSection("script", false);
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        list-style: none;
        text-decoration: none;
        font-size: 16px;
    }

    body {
        margin: 0;
        padding: 0;
    }

    .layout_body {
        display: flex;
        width: 100%;
    }

    .layout_nav {
        flex: 3;
    }

    .layout_content {
        flex: 9;
        margin: 32px 32px 8px;
        height: 100%;
        min-height: 500px;
    }

    .layoutadmin {
        position: relative;
        width: 100%;
    }

    .layout_footer {
    }
</style>
