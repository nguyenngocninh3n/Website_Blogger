<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <script src="~/Scripts/jquery-3.4.1.js"></script>
    <script src="~/Scripts/jquery-3.4.1.js"></script>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
    <link rel=" stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" />

</head>
<body>

    @Html.Action("NavPartial", "Home")
    <div class="main">
        <div class="row">
            <div id="layoutinfor" class=" col-lg-3 col-md-3 col-sm-3 mt-55">
                @if (Session["IDGuest"] != null)
                {
                    <div class="inforpage">
                        @Html.Action("InforPartial", "Home", new { idUser = Session["IDGuest"].ToString() })
                    </div>
                }
                else
                {
                    <div style="display:block"></div>
                }
            </div>
            <div id="layoutbody" class="col-lg-9 col-md-9 col-sm-9 renderbody">
                @RenderBody()
            </div>
        </div>
    </div>
    @Html.Action("FooterPartial", "Home");


    @Scripts.Render("~/bundles/jquery")
  
    @RenderSection("scripts", required: false)
</body>
</html>

    @if (Session["IDGuest"] == null && Session["User"] == null)
            {
              <script>
                  $(document.getElementById("layoutinfor")).removeClass('col-lg-3');
                  $(document.getElementById("layoutinfor")).addClass('col-lg-2');

                  $(document.getElementById("layoutbody")).removeClass('col-lg-9');
                  $(document.getElementById("layoutbody")).addClass('col-lg-8');
              </script>
            }

<style>
        body {
            margin: 0;
            padding: 0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-size: 16px;
        }

        .main {
            max-width: auto;
            margin: auto 5%;
        }
        /*
        .inforpage {
            position:fixed;
            left:5%;

        }*/
        /*
        .footerpage {
            position:fixed;
            bottom:0;
            left:0;
            right: 0;
        }
    */
    .renderbody {
        scroll-behavior: auto;
        min-height: 800px;
        margin-top: 55px;
        /*border-right: 1px solid #ccc;*/
    }

        .mt-55 {
            margin-top: 55px;
            position: relative;
        }

        .pause {
            position: fixed;
            top: 55px;
            width: 21%;
        }
</style>

