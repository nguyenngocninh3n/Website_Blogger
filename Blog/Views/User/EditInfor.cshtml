<h2>EditInfo</h2>
@*<p style="color:red; font-size : 20px;">@ViewBag["Err"];</p>
    <p style="color: red; font-size: 20px;">@ViewBag["ErrSex"];</p>
    <p style="color: red; font-size: 20px;">@ViewBag["ErrSexMode"];</p>*@



<div class="edit_info">
    @using (Html.BeginForm("EditInfor", "User", FormMethod.Post))
    {
        @Html.ValidationSummary(true)
        foreach (var item in Model)
        {
            <div class="infor-user infor-user-edit">
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3">Họ tên: </div>
                    <input class="user_item-content col-lg-7 col-md-7 col-sm-7 name" name="UserName" value="@item.UserName" />

                </div>
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3"> Giới tính:   </div>
                    <div class="col-lg-7 col-md-7 col-sm-7">
                        <input type="radio" class="user_item-content sex" name="Sex" id="Man" value="Man" />  <span>Nam</span>
                        <input type="radio" class="user_item-content sex" name="Sex" id="Woman" value="Woman" />  <span>Nữ</span>
                        <input type="radio" class="user_item-content sex" name="Sex" id="Order" value="Order" />  <span>Khác</span>
                        <script>
                               var str = document.getElementById('@item.Sex.Trim()');
                            str.checked = true;
                        </script>
                    </div>
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="SexMode" id="SexMode" type="checkbox" onload="CheckMode('SexMode', @item.SexMode)" />
                            <span class="slider round"></span>
                            @if (@item.SexMode == true)
                            {
                                <script>
                                    var str = document.getElementById('SexMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                    </div>
                </div>
                <div class="user_item form_datetime row">
                    <div class="col-lg-3 col-md-3 col-sm-3">Ngày sinh:</div>
                    <select name="birthdayday" class="form_date col-lg-2 col-md-2  col-sm-2 ">
                        <option value="@item.Birthday.Day.ToString()">@item.Birthday.Day.ToString()</option>
                        @for (int i = 1; i <= 30; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <select name="birthdaymonth" class="form_date col-lg-2 col-md-2  col-sm-2 ">
                        <option value="@item.Birthday.Month.ToString()">@item.Birthday.Month.ToString()</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i"> Tháng @i</option>
                        }
                    </select>
                    <select name="birthdayyear" class="form_date col-lg-3 col-md-3 col-sm-3 ">
                        <option value="@item.Birthday.Year.ToString()">@item.Birthday.Year.ToString()</option>
                        @for (int i = 1900; i <= 2022; i++)
                        {
                            <option value="@i"> @i</option>
                        }
                    </select>
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="BirthdayMode" id="BirthdayMode" type="checkbox" onload="CheckMode('BirthdayMode', @item.BirthdayMode)" />
                            <span class="slider round"></span>
                        </label>
                        @if (@item.BirthdayMode == true)
                            {
                                <script>
                                    var str = document.getElementById('BirthdayMode');
                                    str.checked = true;
                                </script>
                            }    
                    </div>
                </div>
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3">Học vấn: </div>
                    <input name="Degree" class="user_item-content job col-lg-7 col-md-7 col-sm-7" value="@item.Degree" />
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="DegreeMode" id="DegreeMode" type="checkbox" onload="CheckMode('DegreeMode', @item.DegreeMode)" />
                            <span class="slider round"></span>
                            @if (@item.DegreeMode == true)
                            {
                                <script>
                                    var str = document.getElementById('DegreeMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                    </div>
                </div>
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3">Công việc: </div>
                    <input name="Job" class="user_item-content job col-lg-7 col-md-7 col-sm-7" value="@item.Job" />
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="JobMode" id="JobMode" type="checkbox" />
                            <span class="slider round"></span>
                            @if (@item.JobMode == true)
                            {
                                <script>
                                    var str = document.getElementById('JobMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                     
                    </div>
                </div>
                <div class="user_item row ">
                    <div class=" user_item-lable  col-lg-3 col-md-3 col-sm-3">Địa chỉ: </div>
                    <input name="Address" class="user_item-content col-lg-7 col-md-7 col-sm-7 address" value="@item.Addr" />
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="AddressMode" id="AddressMode" type="checkbox" onload="CheckMode('AddressMode', @item.AddressMode)" />
                            <span class="slider round"></span>
                            @if (@item.AddressMode == true)
                            {
                                <script>
                                    var str = document.getElementById('AddressMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                    </div>
                </div>
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3">Email: </div>
                    <input name="Email" class="user_item-content email col-lg-7 col-md-7 col-sm-7" value="@item.Email" />
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="EmailMode" id="EmailMode" type="checkbox" onload="CheckMode('EmailMode', @item.EmailMode)" />
                            <span class="slider round"></span>
                            @if (@item.EmailMode == true)
                            {
                                <script>
                                    var str = document.getElementById('EmailMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                    </div>
                </div>
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3">Facebook: </div>
                    <input name="Facebook" class="user_item-content facebook col-lg-7 col-md-7 col-sm-7" value="@item.Facebook" />
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="FacebookMode" id="FacebookMode" type="checkbox" onload="CheckMode('FacebookMode', @item.FacebookMode)" />
                            <span class="slider round"></span>
                            @if (@item.FacebookMode == true)
                            {
                                <script>
                                    var str = document.getElementById('FacebookMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                    </div>
                </div>
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3">Instagram: </div>
                    <input name="Instagram" class="user_item-content instagram col-lg-7 col-md-7 col-sm-7" value="@item.Instagram" />
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="InstagramMode" id="InstagramMode" type="checkbox" onload="CheckMode('InstagramMode', @item.InstagramMode)" />
                            <span class="slider round"></span>
                            @if (@item.InstagramMode == true)
                            {
                                <script>
                                    var str = document.getElementById('InstagramMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                    </div>
                </div>
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3">Youtube: </div>
                    <input name="Youtube" class="user_item-content youtube col-lg-7 col-md-7 col-sm-7" value="@item.Youtube" />
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="YoutubeMode" id="YoutubeMode" type="checkbox" onload="CheckMode('YoutubeMode', @item.YoutubeMode)" />
                            <span class="slider round"></span>
                            @if (@item.YoutubeMode == true)
                            {
                                <script>
                                    var str = document.getElementById('YoutubeMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                    </div>
                </div>
                <div class="user_item row">
                    <div class=" user_item-lable col-lg-3 col-md-3 col-sm-3">LinkedIn: </div>
                    <input name="LinkedIn" class="user_item-content linkedin col-lg-7 col-md-7 col-sm-7" value="@item.LinkedIn" />
                    <div class="col-lg-2 col-md-2  col-sm-2">
                        <label class="switch ">
                            <input name="LinkedInMode" id="LinkedInMode" type="checkbox" onload="CheckMode('LinkedInMode', @item.LinkedInMode)" />
                            <span class="slider round"></span>
                            @if (@item.LinkedInMode == true)
                            {
                                <script>
                                    var str = document.getElementById('LinkedInMode');
                                    str.checked = true;
                                </script>
                            }
                        </label>
                    </div>
                </div>
                <div class="user_item row ">
                    <input type="button" onclick="reloadPage()" class="col-lg-4 col-md-4 col-lg-offset-1 col-md-offset-1 form_cancel form_edit-btn" value="Hủy" />
                    <input type="submit" class="col-lg-4 col-md-4 col-lg-offset-1 col-md-offset-1 form_submit form_edit-btn" value="Lưu" />
                </div>
            </div>
        }
    }
</div>

<script>
    function reloadPage() {
        document.location.reload();
    }

    function CheckMode(mode, value) {

        //alert('hi')
        //var itemmode = "'" + mode + "'";
        //var str = document.getElementById(itemmode);
        //str.checked = value;
   
    }

</script>
<style>
    .edit_info {
        font-size: 20px;
    }

    .infor-user-edit {
        padding: 0 10%;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 64px;
        height: 28px;
        margin-left: 32px;
        font-size: 16px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }


    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
    }


        .slider:before {
            position: absolute;
            content: "";
            height: 24px;
            width: 32px;
            left: 3px;
            bottom: 1px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
            content: "OFF";
            padding: 0 2px;
            margin-bottom: 1px;
        }



    input:checked + .slider {
        background-color: #2196F3;
    }



    input:focus + .slider {
        box-shadow: 0 0 1px #2196F3;
    }


    input:checked + .slider:before {
        -webkit-transform: translateX(34px);
        -ms-transform: translateX(34px);
        transform: translateX(26px);
        content: "ON";
        padding: 0 4px;
    }

    /* Rounded sliders */
    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }
</style>